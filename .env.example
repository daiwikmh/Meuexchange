# Creditcoin environment: testnet (CC3 Testnet, chain 102031) or mainnet.
CREDITCOIN_ENV=testnet
PORT=3000

# --- Collateral chain (bullion escrow) ---
# Attestcoin chain keys are not EVM chain IDs. On CC3 Testnet: 1 = Ethereum Sepolia.
SOURCE_CHAIN_KEY=1
SOURCE_CHAIN_RPC_URL=
SOURCE_REGISTRY_ADDRESS=
BULLION_TOKEN_ADDRESS=

# --- Price chain (Chainlink XAU/USD) ---
# The feed lives on Ethereum mainnet, attested by CC3 Testnet as chain key 3.
# Defaults to the aggregator behind the XAU/USD proxy; the proxy itself emits nothing.
# Must serve archive eth_getLogs: the feed's last round may be thousands of
# blocks back. rpc.mevblocker.io and eth.drpc.org do; publicnode does not.
PRICE_CHAIN_RPC_URL=https://rpc.mevblocker.io
GOLD_AGGREGATOR_ADDRESS=
# Backfill from a block containing a known AnswerUpdated round so the desk
# has a gold price without waiting for the next heartbeat.
PRICE_FROM_BLOCK=25955885

# --- Creditcoin ---
ASC_REPO_DESK_ADDRESS=

# Gas-only key for the proof worker. `execute` is permissionless and moves no value,
# so this key can never draw principal or release collateral.
PROOF_WORKER_PRIVATE_KEY=
WORKER_FROM_BLOCK=
INLINE_WORKER=false

# Deployment keys stay out of the API process.
DEPLOYER_PRIVATE_KEY=

# Risk parameters applied to the bullion token at deploy time.
ADVANCE_RATE_BPS=6000
MAINTENANCE_BPS=7500
